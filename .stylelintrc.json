{
  "extends": "stylelint-config-standard",
  "ignoreFiles": [
    "src/pages/guidelines/index.css",
    "src/pages/trading/index.css",
    "src/index.css",
    "reference-index.css"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "layer",
          "custom-variant",
          "theme",
          "inline"
        ]
      }
    ],
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "no-duplicate-selectors": null,
    "number-max-precision": null
  }
}
